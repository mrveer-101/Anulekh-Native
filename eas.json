{
  "cli": {
    "version": ">= 9.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://anulekh-axum.onrender.com"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://anulekh-axum.onrender.com",
        "GRADLE_OPTS": "-Dorg.gradle.jvmargs=\"-Xmx4096m -XX:MaxMetaspaceSize=1024m\" -Dorg.gradle.daemon=false -Dorg.gradle.parallel=true"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://anulekh-axum.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
